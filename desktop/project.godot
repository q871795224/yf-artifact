; Godot 4 desktop client. The canonical rules run in the local Python service.
config_version=5

[application]
config/name="单路战场"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=920
window/size/window_width_override=1280
window/size/window_height_override=920
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.067, 0.088, 0.093, 1)
